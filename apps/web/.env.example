BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3005
DATABASE_PATH=./data/coomander.db

# PostgreSQL — set DATABASE_URL to use PG instead of SQLite.
# When set, DATABASE_PATH is ignored.
# DATABASE_URL=postgres://user:password@localhost:5432/coomander

# App base URL (used in emails, Stripe redirects, etc.)
# APP_URL=https://yourapp.example.com

# App display name (used in emails, MFA enrollment)
# APP_NAME=Coomander

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# OAuth — Apple (https://developer.apple.com/account/resources/identifiers/list/serviceId)
# APPLE_CLIENT_ID is your Services ID (e.g. com.example.app.service), NOT your App Bundle ID.
# APPLE_CLIENT_SECRET is a short-lived JWT you must generate from your private key:
#   1. Create a "Sign In with Apple" key at https://developer.apple.com/account/resources/authkeys/list
#   2. Download the .p8 private key file (Team ID + Key ID shown there)
#   3. Generate the JWT: https://www.better-auth.com/docs/authentication/social-providers/apple
#      or use: npx @better-auth/cli generate-apple-secret
# The generated JWT expires after 6 months — regenerate and redeploy before expiry.
# APPLE_CLIENT_ID=com.example.app.service
# APPLE_CLIENT_SECRET=eyJ...

# OAuth — Facebook / Meta (https://developers.facebook.com/apps/)
# Create an app → Add "Facebook Login" product → Settings → Basic for ID/Secret.
# In production: add your domain to "Valid OAuth Redirect URIs" and supply a Privacy Policy URL.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# OAuth — Microsoft (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade)
# Register an app → Authentication → add redirect URI: {BETTER_AUTH_URL}/api/auth/callback/microsoft
# MICROSOFT_TENANT_ID defaults to "common" (personal + work/school accounts).
# Set to your specific tenant GUID for single-tenant / enterprise-only deployments.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Email — Cloudflare Email Service (migrated off Resend)
# On Workers, the [[send_email]] binding (name="EMAIL") in wrangler.toml sends
# with zero config. Off Workers (Docker/VPS) OR local dev, set the REST creds
# below; with neither, emails are logged to the console (auth links printed).
# EMAIL_FROM=Coomander <noreply@yourdomain.com>
# CLOUDFLARE_ACCOUNT_ID=...                         # for the REST API fallback
# CF_EMAIL_API_TOKEN=...                            # CF token w/ "Email Sending" perms (wrangler secret put CF_EMAIL_API_TOKEN)
# EMAIL_TRACKING_SECRET=...                         # HMAC key for open/click tracking tokens (falls back to BETTER_AUTH_SECRET)

# Campaign send engine — batched producer/consumer (lib/campaign-send.ts, #454/#222)
# CAMPAIGN_BATCH_SIZE=50                             # recipients per batch (CF Queue message / job-queue job); default 50
# STUCK_CAMPAIGN_MINUTES=60                          # reconciler: minutes a campaign can sit in 'sending' with no progress before it's marked failed

# Marketing automation — Loops.so drip engine (optional, activates when set)
# LOOPS_API_KEY=loops_...

# Stripe (https://dashboard.stripe.com/apikeys)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_PRICE_ID=price_...                    # recurring subscription price
# STRIPE_LIFETIME_PRICE_ID=price_...           # one-time lifetime deal price
# STRIPE_WEBHOOK_SECRET=whsec_...

# Waitlist mode — set to "true" to gate signups behind invite codes
# WAITLIST_MODE=true
# NEXT_PUBLIC_WAITLIST_MODE=true

# Analytics — pluggable event tracking (posthog, plausible, console, none)
# ANALYTICS_PROVIDER=posthog
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com
# PLAUSIBLE_DOMAIN=yourapp.com
# PLAUSIBLE_HOST=https://plausible.io

# AI Chatbot — two-tier model catalog. Chat runs through the agents Worker
# (apps/agents, over WebSockets) — the single chat transport (the legacy web SSE
# path was removed in #203). The agent runs both tiers via the Vercel AI SDK:
#   • BYOK Claude (tier "byok") — needs ANTHROPIC_API_KEY (or an admin-set key in
#     /admin/ai-models). https://console.anthropic.com
#   • Workers AI open models (tier "workers-ai", @cf/... ids) — NO provider key;
#     billed via your Cloudflare account through the `AI` binding (the agents
#     wrangler.toml [ai] block). On Cloudflare Workers (prod) the binding works
#     directly.
#     ── LOCAL / DOCKER DEV ── Workers AI inference can't run in miniflare, so
#     `wrangler dev` proxies the `AI` binding to REMOTE Cloudflare. It does that by
#     deploying a temporary PREVIEW WORKER, so the credential needs WORKERS SCRIPTS
#     access — NOT just Workers AI. A Workers-AI-only token can run AI over REST but
#     403s on edge-preview, so wrangler dev never starts. Create a token from the
#     "Edit Cloudflare Workers" template (grants Workers Scripts: Edit) and add
#     "Workers AI: Read"; set it as CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID.
#     Simplest for NON-Docker local dev: `wrangler login` (OAuth), no token needed.
#     NOTE: because the [ai] binding makes wrangler dev open the proxy AT BOOT, the
#     agents-dev Worker won't start in Docker at all — even for CLAUDE-only chat —
#     without valid CF auth here. Claude itself only needs ANTHROPIC_API_KEY. Prod
#     (on Workers) needs neither token nor login.
# ANTHROPIC_API_KEY=sk-ant-...
# CLOUDFLARE_API_TOKEN=...       # dev-only: "Edit Cloudflare Workers" token + Workers AI: Read (wrangler dev deploys a preview Worker to proxy the AI binding)
# CHAT_MODEL=claude-sonnet-4-6        # optional, defaults to Sonnet 4.6
# CHAT_MAX_TOKENS=1024                         # optional, max tokens per response

# ── AI Gateway + provider keys + usage dashboard (#203) ─────────────────────
# Optional: route AI through a Cloudflare AI Gateway for usage/cost analytics,
# caching, and fallback (https://developers.cloudflare.com/ai-gateway/). Create
# a gateway in the CF dashboard, then set the two below (+ CLOUDFLARE_ACCOUNT_ID,
# shared with the Email Service section above). If unset, the app calls Anthropic
# directly — no behavior change.
# AI_GATEWAY_ID=coomander-gateway              # the gateway's name/slug (leave unset → direct Anthropic)
# AI_GATEWAY_TOKEN=...                          # only if the gateway is "authenticated" (cf-aig-authorization); a SECRET
#
# Provider keys can also be set at runtime from the admin UI (encrypted at rest;
# an admin-set key takes precedence over the ANTHROPIC_API_KEY env var above).
# Encryption uses PROVIDER_KEY_KEK if set, else falls back to BETTER_AUTH_SECRET.
# Set a dedicated KEK in production so rotating the auth secret doesn't orphan
# stored provider keys. Optional ENV vars for other providers: OPENAI_API_KEY,
# GOOGLE_API_KEY.
# PROVIDER_KEY_KEK=                            # optional dedicated key-encryption key (openssl rand -base64 32)
#
# In-app AI usage & cost dashboard (/admin/ai-usage). Reads AI Gateway metrics
# (requests/tokens/cost/latency/cache-hit, per model + per user) from the
# Cloudflare GraphQL Analytics API. Requires CF_ANALYTICS_API_TOKEN with
# ACCOUNT Analytics: Read, plus CLOUDFLARE_ACCOUNT_ID and AI_GATEWAY_ID (above).
# If any is unset, the dashboard shows a friendly empty-state.
# CF_ANALYTICS_API_TOKEN=...                    # Cloudflare API token with "Account Analytics: Read"
# CLOUDFLARE_ACCOUNT_ID=...                     # the account the gateway lives in (also referenced above)

# Agents Worker (apps/agents) — Cloudflare Agents SDK sidecar (#192)
# AGENTS_INTERNAL_SECRET: shared secret for server-to-server agent → web calls
#   (scheduled wakes). MUST match AGENTS_INTERNAL_SECRET in apps/agents/.dev.vars.
# NEXT_PUBLIC_AGENTS_URL: where the browser reaches the agents Worker. Leave
#   unset in dev — Caddy routes same-origin /agents/* to the sidecar. Set to the
#   agents Worker origin only if it is served on a different host.
# AGENTS_INTERNAL_SECRET=dev-agents-internal-secret-change-me
# NEXT_PUBLIC_AGENTS_URL=

# Voice — ElevenLabs TTS (https://elevenlabs.io — optional, text-only if unset)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9   # optional, default voice

# Error monitoring — Sentry (https://sentry.io — free tier: 5K errors/month)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_...   # optional, for source map upload

# Admin — comma-separated list of emails to bootstrap as admins on startup
ADMIN_EMAILS=admin@example.com

# Instagram OAuth (https://developers.facebook.com/apps)
# Create an app → add "Instagram" product → "Instagram API with Instagram Login"
# Add OAuth redirect URIs:
#   http://localhost:3005/api/platforms/instagram/oauth/callback        (dev)
#   https://coomander.gate-cardassian.ts.net/api/platforms/instagram/oauth/callback  (tailnet dev)
#   https://your-prod-domain/api/platforms/instagram/oauth/callback     (prod)
# Required scopes: instagram_business_basic, instagram_business_manage_insights
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# Optional override; defaults to {request_origin}/api/platforms/instagram/oauth/callback
# INSTAGRAM_OAUTH_REDIRECT_URI=

# ── Coomander — AI ops agent (#151) ─────────────────────────────────────────
# Telegram bot token for @coomander_bot (BotFather). Kept out of git; set as a
# wrangler secret in prod (`wrangler secret put MADDIE_TELEGRAM_BOT_TOKEN`) and
# in .env.local for dev. Outbound Telegram (cron pings) requires this.
# MADDIE_TELEGRAM_BOT_TOKEN=
# Shared secret guarding POST /api/coomander/run (the cron target). Generate with
# `openssl rand -hex 32`. Set as a wrangler secret in prod and in .env.local for dev.
# COOMANDER_RUN_SECRET=
# Secret Telegram echoes back on the inbound webhook (set as secret_token at
# setWebhook). Generate with `openssl rand -hex 24`. Set as a wrangler secret in
# prod; the /api/coomander/webhook route 503s until it is set.
# MADDIE_TELEGRAM_WEBHOOK_SECRET=
# Bot @username (no @) used to build the "Connect Telegram" deep link
# (t.me/<username>?start=<code>). Defaults to "coomander_bot" (prod). In LOCAL
# dev set this to YOUR dev bot's username so the Connect flow points at the dev
# bot, not prod's.
# COOMANDER_BOT_USERNAME=coomander_bot
# Full public URL Telegram should POST inbound updates to — used by
# `npm run telegram:webhook -- set`. In dev this is your Cloudflare Tunnel
# hostname + the webhook path. See README → "Local Telegram dev".
# TELEGRAM_WEBHOOK_URL=https://dev-you.coomander.com/api/coomander/webhook
# Anthropic model for Coomander pings + inbound classification (optional;
# defaults to claude-sonnet-4-6).
# COOMANDER_AGENT_MODEL=claude-sonnet-4-6
# Explicit opt-out for outbound Telegram (1/true to force OFF). Default is ENABLED
# in ALL environments (the bot is Coomander-dedicated). Do NOT set a forcing value
# in .env.local — it bakes into the prod bundle (next-env.mjs). Leave unset.
# COOMANDER_TELEGRAM_DISABLED=

# ── Remote dev over HTTPS — Tailscale + Caddy sidecar ───────────────────────
# Required for phone QA (iOS Safari refuses plain HTTP on *.ts.net). Auth key
# from https://login.tailscale.com/admin/settings/keys. Final URL:
# https://${TS_HOSTNAME}.gate-cardassian.ts.net
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=coomander
# DEV_PORT=3005
