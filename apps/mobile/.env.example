# Base URL of the Coomander API the mobile app authenticates against.
# Must be reachable from the device/simulator running the app:
#   - iOS simulator on the same Mac: http://localhost:3005
#   - Physical phone (via Tailscale): https://coomander.gate-cardassian.ts.net
#     (HTTPS is required on iOS; plain HTTP on *.ts.net is blocked by Safari)
#   - Production: https://coomander.com
# Default to production for Expo Go QA — the chat, agent, and email are live there.
EXPO_PUBLIC_API_URL=https://coomander.com
