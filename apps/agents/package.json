{
  "name": "@coomander/agents",
  "version": "0.3.0",
  "private": true,
  "description": "Coomander sidecar agent Worker — Coomander as a per-user stateful agent on the Cloudflare Agents SDK",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "deploy": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --env production --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.84",
    "@coomander/core": "*",
    "agents": "0.14.5",
    "ai": "6.0.206",
    "workers-ai-provider": "3.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.13",
    "@cloudflare/workers-types": "4.20260608.1",
    "typescript": "^5",
    "vitest": "4.1.8",
    "wrangler": "4.98.0"
  }
}
